rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      // In free access mode, we consider everyone "signed in" to satisfy logic, 
      // but we actually allow public access below.
      return true;
    }

    function isOwner(userId) {
      return true;
    }

    function isAdmin() {
      return true;
    }

    function isVerifiedAdmin() {
      return isAdmin() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Schema Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().size() <= 10 &&
             data.uid is string &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidArea(data) {
      return data.keys().hasAll(['name', 'color']) &&
             data.keys().size() <= 10 &&
             data.name is string && data.name.size() <= 100 &&
             data.color is string && data.color.matches('^#[a-fA-F0-9]{6}$');
    }

    function isValidTask(data) {
      return data.keys().hasAll(['areaId', 'name', 'frequency', 'suggestedMonths']) &&
             data.keys().size() <= 10 &&
             data.areaId is string && isValidId(data.areaId) &&
             data.name is string && data.name.size() <= 200 &&
             data.frequency in ['Mensal', 'Trimestral', 'Semestral', 'Anual'] &&
             data.suggestedMonths is list && data.suggestedMonths.size() <= 12;
    }

    function isValidDesignation(data) {
      return data.keys().hasAll(['areaId', 'volunteers']) &&
             data.keys().size() <= 10 &&
             data.areaId is string && isValidId(data.areaId) &&
             data.volunteers is list && data.volunteers.size() <= 50;
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['title', 'date', 'startTime', 'endTime', 'type']) &&
             data.keys().size() <= 15 &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.type in ['emergency', 'regular', 'training'];
    }

    // Collection Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    match /areas/{areaId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /designations/{areaId} {
      allow read, write: if true;
    }

    match /meetings/{meetingId} {
      allow read, write: if true;
    }
    
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
