rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVerifiedAdmin() {
      return isAdmin() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Schema Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().size() <= 10 &&
             data.uid is string &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidArea(data) {
      return data.keys().hasAll(['name', 'color']) &&
             data.keys().size() <= 10 &&
             data.name is string && data.name.size() <= 100 &&
             data.color is string && data.color.matches('^#[a-fA-F0-9]{6}$');
    }

    function isValidTask(data) {
      return data.keys().hasAll(['areaId', 'name', 'frequency', 'suggestedMonths']) &&
             data.keys().size() <= 10 &&
             data.areaId is string && isValidId(data.areaId) &&
             data.name is string && data.name.size() <= 200 &&
             data.frequency in ['Mensal', 'Trimestral', 'Semestral', 'Anual'] &&
             data.suggestedMonths is list && data.suggestedMonths.size() <= 12;
    }

    function isValidDesignation(data) {
      return data.keys().hasAll(['areaId', 'volunteers']) &&
             data.keys().size() <= 10 &&
             data.areaId is string && isValidId(data.areaId) &&
             data.volunteers is list && data.volunteers.size() <= 50;
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['title', 'date', 'startTime', 'endTime', 'type']) &&
             data.keys().size() <= 15 &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.type in ['emergency', 'regular', 'training'];
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    match /areas/{areaId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidArea(incoming());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidTask(incoming());
      allow delete: if isAdmin();
    }

    match /designations/{areaId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidDesignation(incoming());
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidMeeting(incoming());
      allow delete: if isAdmin();
    }
    
    // Admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      // Permite o bootstrap inicial para e-mails conhecidos
      allow create: if isSignedIn() && adminId == request.auth.uid && 
                    (request.auth.token.email.matches('(?i).*jaazielss@gmail\\.com') || 
                     request.auth.token.email.matches('(?i).*comissao.*congrega.*'));
      allow update, delete: if false; 
    }
  }
}
